{
  "name": "inrocompras",
  "version": "0.1.0",
  "private": true,
  "description": "INROCOMPRAS: Compras e Importaciones de INROPRIN (Next.js + Supabase)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:db": "node supabase/tests/todas.mjs",
    "test": "vitest run",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm format:check && pnpm test && pnpm test:db",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@googleapis/drive": "27.0.0",
    "@googleapis/gmail": "22.0.2",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "^1.59.0",
    "neverthrow": "^8.2.0",
    "next": "16.4.6",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "unpdf": "1.9.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
