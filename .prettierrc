{
    "printWidth": 160,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "auto",
    "overrides": [{ "files": ["*.json", "*.md", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } }]
}
