# Copia este archivo a .env.local (y las mismas variables en Vercel). Nunca subas valores reales al repo.
# Detalle de cada integración: docs/07_INTEGRACIONES.md

# ── Públicas (van al navegador) ──
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
NEXT_PUBLIC_DOMINIO=inroprin.com

# ── Solo servidor (NUNCA con NEXT_PUBLIC_) ──
# Llave service_role de Supabase: la usan /api/cola y /api/inropay. Salta RLS.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app (enlaces de los correos), sin barra al final.
APP_URL=http://localhost:3000
# Secreto del cron: /api/cola exige «Authorization: Bearer <CRON_SECRET>». Vercel lo manda solo al cron.
# vercel.json corre el cron una vez al día (06:00 UTC) porque el plan es Hobby; en Pro, cámbialo a «* * * * *»
# (cada minuto). Entre corridas, la cola también se despierta con POST /api/cola/despertar tras cada acción.
CRON_SECRET=

# ── Google Drive: legajo en una Unidad compartida (cuenta de servicio = Administrador de contenido) ──
# El JSON completo de la cuenta de servicio, en una línea. Sin estas 3, los trabajos de Drive quedan en Error
# «Drive no configurado» (se reintentan desde Configuración al configurarlo).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Carpetas madre del legajo (docs/13 §1.1). MIENTRAS SE VALIDA: una carpeta de PRUEBA compartida con la cuenta de
# servicio como Editor. Al arrancar: «5. Ordenes de Compra» y la madre de importaciones. Si falta una, se usa la común.
DRIVE_RAIZ_NACIONAL_ID=
DRIVE_RAIZ_IMPORTACION_ID=
DRIVE_CARPETA_RAIZ_ID=
# Solo si las carpetas están en una Unidad compartida:
DRIVE_UNIDAD_ID=

# ── Correo (Google Workspace) ──
# registro = no envía nada (solo log; el trabajo queda «Descartado» con ese motivo) · gmail = Gmail API con
# delegación de dominio solo para gmail.send · smtp = relay SMTP de Workspace.
CORREO_MODO=registro
# Remitente: «INROCOMPRAS <notificaciones@dominio>». En gmail, la cuenta en la que se delega.
CORREO_REMITENTE=
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Lector de cotizaciones y facturas ──
# Sin GEMINI_API_KEY se usa solo la lectura gratuita del texto del PDF (y avisa). Plan gratuito: ver D-07.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# RUC de las empresas del grupo, separados por coma: nunca se proponen como proveedor.
RUCS_PROPIOS=

# ── InroPay (pagos de Finanzas) ──
# Sin INROPAY_URL no se envían solicitudes (el trabajo queda «Descartado»); Finanzas usa los botones de la app.
INROPAY_URL=
INROPAY_TOKEN=
# Secreto compartido para verificar la firma HMAC-SHA256 (x-inropay-firma) del webhook POST /api/inropay.
INROPAY_WEBHOOK_SECRET=

# Google Chat (avisos a espacios, como los bots «Chat …» del AppSheet). JSON: nombre del espacio → URL del webhook
# entrante (Espacio → Apps e integraciones → Webhooks). Lleva un token: solo en el servidor (Vercel), nunca en el repo.
# Qué cambios de estado van a cada espacio se elige en Configuración → Parámetros → «Avisos a Google Chat».
GOOGLE_CHAT_WEBHOOKS=
